# Application
APP_NAME=SQLMind AI
APP_VERSION=1.0.0
LOG_LEVEL=INFO
ENVIRONMENT=development

# LLM ? choose one: ollama | openai | gemini | claude | groq
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Security / limits
QUERY_TIMEOUT_SECONDS=30
MAX_ROWS=1000
MAX_SQL_RETRIES=3
READ_ONLY_MODE=true

# Paths
EXPORT_DIR=exports
DATA_DIR=data
AUDIT_LOG_PATH=data/audit.log
HISTORY_DB_PATH=data/sqlmind_history.sqlite3
CHECKPOINT_DB_PATH=data/sqlmind_checkpoints.sqlite3

# LangSmith observability (optional)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=SQLMind-AI
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# OpenTelemetry (optional; set OTEL_ENABLED=true to activate nested agent/tool/plugin spans)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=SQLMind-AI
OTEL_EXPORTER=console
# OTEL_ENDPOINT=http://localhost:4318/v1/traces
# For production: OTEL_EXPORTER=otlp and set OTEL_ENDPOINT


# Memory
MEMORY_MAX_TURNS=24
MEMORY_SUMMARIZE_AFTER=12

# Actor / tenancy defaults (local Streamlit)
DEFAULT_TENANT_ID=default
DEFAULT_ACTOR=local-user

# Phase 2 ? Goal planner
AUTONOMY_PLANNING_ENABLED=true
GOAL_CLARIFY_THRESHOLD=0.55

# Phase 3 ? Enterprise Agentic AI Platform
ENTERPRISE_ENABLED=true
ENTERPRISE_SUBGRAPHS_ENABLED=true
ENTERPRISE_IAM_ENFORCEMENT=true
ENTERPRISE_CIRCUIT_BREAKER=true
VECTOR_MEMORY_ENABLED=true
VECTOR_MEMORY_DB_PATH=
# Embedding: hashing | ollama | openai | sentence_transformers | bge | e5 | nomic
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=
EMBEDDING_DIM=256
MEMORY_TTL_SECONDS=0
GOAL_STORE_DB_PATH=
IAM_DB_PATH=
IAM_USERNAME=local-user
IAM_PASSWORD=local-dev
IAM_API_KEY=
LEARNING_DB_PATH=
DLQ_DB_PATH=
PLUGIN_DIRS=plugins
PLUGIN_HOT_RELOAD=true
PLUGIN_REQUIRE_SIGNATURE=false
PLUGIN_SIGNING_SECRET=sqlmind-plugin-dev-secret
APPROVAL_GATES_ENABLED=true
REQUIRE_WRITE_SQL_APPROVAL=true
REQUIRE_SENSITIVE_EXPORT_APPROVAL=true
ENTERPRISE_EVENTS_LOG_PATH=data/enterprise_events.jsonl
AGENT_HEARTBEAT_STALE_SECONDS=60
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30
PROMETHEUS_ENABLED=true
METRICS_EXPORT_PATH=data/sqlmind_metrics.prom

# Runtime Execution Trace System (enterprise architecture audit)
RUNTIME_TRACE_ENABLED=true
RUNTIME_TRACE_DIR=data/runtime_traces
RUNTIME_TRACE_PRINT_SUMMARY=true

# Phase 4 ? Production enterprise extensions
METRICS_HTTP_ENABLED=true
METRICS_HTTP_HOST=127.0.0.1
METRICS_HTTP_PORT=9108
MAX_RUNTIME_REPLANS=2
RECOVERY_CONTROLLER_ENABLED=true
EXPORT_ASYNC_ENABLED=true
PLUGIN_RUNTIME_ENABLED=true
PLUGIN_TIMEOUT_SECONDS=15
DISTRIBUTED_EXECUTION_ENABLED=true
DISTRIBUTED_WORKER_COUNT=2
DISTRIBUTED_QUEUE_DB_PATH=
ENTERPRISE_QUEUE_DB_PATH=
