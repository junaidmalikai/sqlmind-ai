# SQLite / vector / metrics artifacts anywhere
# Sample retail DB is generated at runtime into data/ via sample_data/seed.py
*.db
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.prom

# Runtime traces, checkpoints, local reports
**/runtime_traces/
checkpoints/
*.checkpoint
*_checkpoints.*

# Enterprise / observability local dumps (under data/ already ignored; belt-and-suspenders)
*.jsonl

# Temporary / backup / debug
*.tmp
*.temp
*.bak
*.backup
*.orig
*.old
debug_*.txt
*_debug.*

# Local plugin / metrics / screenshot scratch (not portfolio assets)
.plugins_cache/
metrics_local/
local_screenshots/
*.stackdump

